# ---------------------------------------------------------------------------
# WearWise AI — environment variables
# Copy to .env.local and fill in what you have. Everything is optional:
# the app runs fully with seeded data and a local recommendation engine.
# ---------------------------------------------------------------------------

# Used to sign session cookies. Set any long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Live AI stylist (Google AI Studio key). Server-side only — never exposed.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Base URL used for absolute links (affiliate redirects, metadata, emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (optional — for hosted Postgres + Auth + Storage)
# The included Supabase schema lives in supabase/schema.sql.
# When these are absent the app uses the local JSON store in data/store.json.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
